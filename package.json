{
  "name": "blop",
  "version": "0.1.0",
  "description": "A tiny, typed code generator for Bun: prompts become flags, templates are TypeScript, and every run is planned before anything is written.",
  "type": "module",
  "author": "Seth Davis",
  "license": "MIT",
  "homepage": "https://github.com/sethdavis512/blop#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sethdavis512/blop.git"
  },
  "bugs": {
    "url": "https://github.com/sethdavis512/blop/issues"
  },
  "keywords": [
    "bun",
    "cli",
    "code-generator",
    "generator",
    "scaffolding",
    "plop",
    "typescript",
    "ai-agents"
  ],
  "bin": {
    "blop": "./cli.ts"
  },
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "start": "bun run cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "compile": "bun build --compile --minify --bytecode ./cli.ts --outfile dist/blop",
    "compile:linux-x64": "bun build --compile --minify --bytecode --target=bun-linux-x64 ./cli.ts --outfile dist/blop-linux-x64",
    "compile:linux-arm64": "bun build --compile --minify --bytecode --target=bun-linux-arm64 ./cli.ts --outfile dist/blop-linux-arm64",
    "compile:darwin-x64": "bun build --compile --minify --bytecode --target=bun-darwin-x64 ./cli.ts --outfile dist/blop-darwin-x64",
    "compile:darwin-arm64": "bun build --compile --minify --bytecode --target=bun-darwin-arm64 ./cli.ts --outfile dist/blop-darwin-arm64",
    "compile:windows-x64": "bun build --compile --minify --bytecode --target=bun-windows-x64 ./cli.ts --outfile dist/blop-windows-x64",
    "compile:all": "bun run compile:linux-x64 && bun run compile:linux-arm64 && bun run compile:darwin-x64 && bun run compile:darwin-arm64 && bun run compile:windows-x64"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": ">=5"
  },
  "dependencies": {
    "@inquirer/core": "^12.0.4",
    "@inquirer/prompts": "^8.7.3",
    "commander": "^15.0.0"
  }
}
